"source_fields":["ingredients","allergen_statement","product_name"],"effect":"suppress_overlapping_parent_match_only"}]},"threshold_rules":[],"cross_reactivity_rules":[{"rule_id":"YFS-XR-001","trigger_category":"aci_bakla_alerjisi","trigger_type":"category","relationship_type":"cross_reactivity","mechanism":"Yer fıstığı ve lupin, homolog baklagil depo proteinleri üzerinden IgE çapraz reaktivitesi gösterebilir. Klinik çapraz alerji mümkündür ancak yer fıstığı alerjisi olan her kişide lupin alerjisi bulunduğu varsayılamaz.","clinical_relevance":"moderate","evidence_level":"strong","affects_primary_status":false,"show_to_user":true,"source_refs":["PUBMED-36191849"]}],"negative_claims":["yer fıstıksız","yerfıstıksız","yer fıstığı içermez","yerfıstığı içermez","yer fıstığı içermemektedir","yerfıstığı içermemektedir","yer fıstığı içermeyen","yerfıstığı içermeyen","yer fıstığı içermez ürün","peanut-free","peanut free","free from peanuts","free from peanut","contains no peanuts","contains no peanut","groundnut-free","groundnut free"],"negation_rules":{"enabled":true,"scope":"same_segment","never_override_contains":true,"never_override_may_contain":true,"detect_conflicts":true,"broad_claims_do_not_suppress":true},"decision_rules":{"status_priority":["contains","may_contain","ambiguous","no_declared_allergen_detected"],"regulatory_exemptions_apply_per_match":true,"negative_claim_does_not_override_contains":true,"conflict_detection":true,"cross_reactivity_affects_primary_status":false,"deduplicate_same_category_matches":true,"prefer_most_specific_match":true,"pal_segment_reclassifies_contains_as_may_contain":true,"product_name_flavor_context_requires_ingredient_confirmation":true,"insufficient_data_enabled":true,"ingredients_required_for_negative_result":true},"warning_texts":{"contains":"Bu ürünün etiketinde yer fıstığı veya yer fıstığı ürünü tespit edildi.","may_contain":"Bu ürünün etiketinde yer fıstığı için ihtiyati alerjen bildirimi tespit edildi.","ambiguous":"Etikette yer fıstığı anlamına gelebilecek ancak başka bir fıstık türünü de ifade edebilen '{trigger}' ifadesi bulundu. Ürün içeriği veya daha spesifik kaynak bilgisi olmadan bunun yer fıstığı olduğu kesinleştirilemiyor.","refined_peanut_oil":"Etikette rafine veya tam rafine yer fıstığı yağı tespit edildi. Rafine yağlarda protein miktarı önemli ölçüde azalabilse de Türk mevzuatında yer fıstığı yağı için rafinasyona dayalı bir alerjen bildirim muafiyeti bulunmamaktadır.","cross_reactivity_lupin":"Yer fıstığı ile acı bakla (lupin) arasında çapraz reaktivite görülebilir. Acı bakla bulunması tek başına ürünün yer fıstığı içerdiği anlamına gelmez.","data_conflict":"Ürün bilgilerinde yer fıstığı açısından birbiriyle çelişen beyanlar tespit edildi. Pozitif içerik kanıtı daha ihtiyatlı sonuç olarak korunuyor.","no_declared_allergen_detected":"Mevcut ve okunabilir etiket bilgilerinde yer fıstığı veya yer fıstığı ürünü tespit edilmedi.","insufficient_data":"Bu ürün için yer fıstığını güvenilir biçimde değerlendirecek yeterli etiket bilgisi bulunmuyor."},"related_categories":["aci_bakla_alerjisi"],"conflicts_with":[],"metadata":{"created_at":"","last_reviewed_at":"2026-09-13","last_reviewed_by":"CEO"}}