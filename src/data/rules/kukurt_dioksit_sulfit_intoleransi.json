pressed as SO₂","total sulfur dioxide equivalent","total sulphur dioxide equivalent"],"operator":">","threshold":10,"units":["mg/kg","mg/L"],"basis":"SO2_equivalent","product_state":"ready_to_consume_or_prepared_according_to_manufacturer_instructions","is_safety_threshold":false,"source_fields":["ingredients","allergen_statement","claims","nutrition_facts"],"output_field":"threshold_status","output_values":{"value_greater_than_10":"exceeded","value_equal_to_10":"not_exceeded","value_less_than_10":"not_exceeded","sulfite_source_without_total_SO2_value":"unknown","amount_not_explicitly_total_SO2_equivalent":"not_evaluable","partial_SO2_fraction_only":"not_evaluable","missing_or_unusable_unit":"not_evaluable","ready_to_consume_basis_unknown":"not_evaluable","range_or_inequality_crosses_threshold":"not_evaluable"},"recognized_qualitative_threshold_statements":[{"phrases":["10 mg/kg'dan az sülfit içerir","10 mg/L'den az sülfit içerir","10 mg/kg'dan az kükürt dioksit içerir","10 mg/L'den az kükürt dioksit içerir","contains less than 10 ppm sulfites","contains less than 10 ppm sulphites","contains less than 10 ppm sulfur dioxide","contains less than 10 ppm sulphur dioxide"],"presence_status":"contains","threshold_status":"not_exceeded","numeric_unit_conversion_required":false}],"source_refs":["TR-TGK-KODEKS-SULFIT"]}],"cross_reactivity_rules":[],"negative_claims":["kükürt dioksit içermez","kükürt dioksit içermemektedir","kükürt dioksit içermeyen","sülfit içermez","sülfit içermemektedir","sülfit içermeyen","sülfitsiz","sulfite-free","sulfite free","sulphite-free","sulphite free","free from sulfites","free from sulphites","contains no sulfites","contains no sulphites"],"negation_rules":{"enabled":true,"scope":"same_segment","never_override_contains":true,"never_override_may_contain":true,"detect_conflicts":true,"broad_claims_do_not_suppress":true},"decision_rules":{"status_priority":["contains","may_contain","ambiguous","no_declared_allergen_detected"],"regulatory_exemptions_apply_per_match":true,"negative_claim_does_not_override_contains":true,"conflict_detection":true,"cross_reactivity_affects_primary_status":false,"deduplicate_same_category_matches":true,"prefer_most_specific_match":true,"pal_segment_reclassifies_contains_as_may_contain":true,"product_name_flavor_context_requires_ingredient_confirmation":true,"insufficient_data_enabled":true,"ingredients_required_for_negative_result":true,"threshold_evaluation_is_separate_from_presence_status":true,"threshold_comparison_requires_total_SO2_equivalent_basis":true,"threshold_uses_ready_to_consume_or_as_prepared_value":true,"partial_SO2_fractions_do_not_determine_regulatory_threshold":true,"threshold_parser_preserves_inequality_and_range_semantics":true,"no_added_sulfites_is_not_negative_claim":true,"sulfite_source_detection_does_not_imply_threshold_exceeded":true,"generic_sulfur_does_not_match_sulfites":true,"generic_sulfate_does_not_match_sulfites":true},"warning_texts":{"contains":"Bu ürünün etiketinde kükürt dioksit veya sülfit kaynağı tespit edildi. Bu tespit maddenin varlığını gösterir; toplam SO2 miktarı ayrıca belirtilmediyse Türk mevzuatındaki 10 mg/kg veya 10 mg/L bildirim eşiğinin aşılıp aşılmadığı yalnız bu eşleşmeden belirlenemez.","contains_sulfite_threshold_unknown":"Etikette {trigger} tespit edildi. Üründe sülfit/kükürt dioksit kaynağı bulunduğu anlaşılıyor ancak toplam SO2 miktarı belirtilmediği için mevzuat eşiğinin aşılıp aşılmadığı belirlenemiyor.","explicit_sulfite_declaration_threshold_unknown":"Etikette açık sülfit/kükürt dioksit bildirimi tespit edildi. Toplam SO2 miktarı verilmediği için 10 mg/kg veya 10 mg/L mevzuat eşiğinin nicel durumu ayrıca belirlenemiyor.","naturally_occurring_sulfites":"Etikette doğal olarak oluşan sülfitlerin bulunduğuna dair açık bir bildirim tespit edildi. 'Doğal' olması sülfit varlığını ortadan kaldırmaz.","threshold_exceeded":"Etikette veya güvenilir ürün verisinde toplam SO2 değeri Türk mevzuatındaki 10 mg/kg veya 10 mg/L sınırının üzerinde tespit edildi. Bu eşik bir kişisel güvenlik veya tolerans sınırı değildir.","threshold_not_exceeded":"Belirtilen toplam SO2 değeri Türk mevzuatındaki >10 mg/kg veya >10 mg/L bildirim eşiğini aşmıyor. Bu durum ürünün sülfit duyarlılığı olan herkes için güvenli olduğu anlamına gelmez.","threshold_unknown":"Sülfit/kükürt dioksit kaynağı tespit edildi ancak toplam SO2 miktarı bilinmediğinden mevzuat eşiği değerlendirilemiyor.","threshold_not_evaluable":"Bir sülfit veya SO2 miktarı belirtilmiş olsa da değer toplam SO2 eşdeğeri, uygun ölçü birimi veya tüketime hazır ürün esasına göre doğrulanamadığından mevzuat eşiği hesaplanamıyor.","may_contain":"Bu ürünün etiketinde kükürt dioksit veya sülfitler için ihtiyati bir bildirim tespit edildi.","import_or_legacy_sulfite_code":"Etikette sülfit kaynağına karşılık gelen ithal veya farklı kodlama sistemine ait {trigger} tespit edildi. Bu kod güncel Türk E-kodu çekirdek listesinde yer almasa da Codex sisteminde sülfit kaynağı olarak tanımlanabilir.","data_conflict":"Ürün bilgilerinde sülfit/kükürt dioksit açısından birbiriyle çelişen beyanlar tespit edildi. Pozitif içerik kanıtı daha ihtiyatlı sonuç olarak korunuyor.","no_declared_allergen_detected":"Mevcut ve okunabilir etiket bilgilerinde kükürt dioksit veya sülfit kaynağı tespit edilmedi.","insufficient_data":"Bu ürün için kükürt dioksit ve sülfitleri güvenilir biçimde değerlendirecek yeterli etiket bilgisi bulunmuyor.","ambiguous":"Etikette kükürt dioksit veya sülfitler açısından kesin olarak sınıflandırılamayan bir ifade tespit edildi. İçerik ve miktar bilgisinin ayrıca kontrol edilmesi önerilir."},"related_categories":[],"conflicts_with":[],"metadata":{"created_at":"2026-07-19","last_reviewed_at":"2026-09-12","last_reviewed_by":"CEO"}}