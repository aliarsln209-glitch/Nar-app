"lexical_exclusions":[{"exclusion_id":"BLK-LEX-001","parent_keyword":"balık","phrases":["mürekkep balığı"],"source_fields":["ingredients","allergen_statement","product_name"],"effect":"suppress_overlapping_parent_match_only"},{"exclusion_id":"BLK-LEX-002","parent_keyword":"havyar","phrases":["patlıcan havyarı","vegan havyar","bitkisel havyar","yosun havyarı"],"source_fields":["ingredients","product_name","allergen_statement"],"effect":"suppress_overlapping_parent_match_only"},{"exclusion_id":"BLK-LEX-003","parent_keyword":"palamut","phrases":["meşe palamudu","meşe palamudu unu","palamut unu","meşe palamudu tozu"],"source_fields":["ingredients","product_name","allergen_statement"],"effect":"suppress_overlapping_parent_match_only"}]},"threshold_rules":[],"cross_reactivity_rules":[],"negative_claims":["balık içermez","balık içermemektedir","balık içermeyen","balıksız","fish-free","fish free","free from fish"],"negation_rules":{"enabled":true,"scope":"same_segment","never_override_contains":true,"never_override_may_contain":true,"detect_conflicts":true,"broad_claims_do_not_suppress":true},"decision_rules":{"status_priority":["contains","may_contain","ambiguous","no_declared_allergen_detected"],"regulatory_exemptions_apply_per_match":true,"negative_claim_does_not_override_contains":true,"conflict_detection":true,"cross_reactivity_affects_primary_status":false,"deduplicate_same_category_matches":true,"prefer_most_specific_match":true,"pal_segment_reclassifies_contains_as_may_contain":true,"product_name_flavor_context_requires_ingredient_confirmation":true,"insufficient_data_enabled":true,"ingredients_required_for_negative_result":true},"warning_texts":{"contains":"Bu ürünün etiketinde {trigger} tespit edildi. Bu ifade balık veya balık kaynaklı bir ürünü gösterir ve seçtiğiniz balık alerjisi açısından dikkate alınmalıdır.","contains_fish_oil":"Etikette balık yağı beyanı tespit edildi. Rafine balık yağlarında alerjen protein miktarı düşük olabilir; ancak balık yağı balık kaynaklı bir üründür, Türk mevzuatında bu kullanım için spesifik bir istisna bulunmamaktadır ve kişisel tolerans mevcut etiketten belirlenemez.","may_contain":"Bu ürünün etiketinde balık veya balık ürünleri için ihtiyati alerjen ya da çapraz bulaşma bildirimi tespit edildi.","ambiguous":"Etiketteki {trigger} ifadesi balık, kabuklu veya yumuşakça gibi farklı deniz ürünü gruplarını ifade edebilir. Mevcut etiket bilgisinden balık kaynağı kesin olarak belirlenemiyor.","data_conflict":"Ürün bilgilerinde balık açısından birbiriyle çelişen beyanlar tespit edildi. Daha ihtiyatlı sonuç gösteriliyor.","no_declared_allergen_detected":"Mevcut ve okunabilir etiket bilgilerinde balık veya balık ürünü tespit edilmedi.","insufficient_data":"Bu ürün için balık alerjenini güvenilir biçimde değerlendirecek yeterli etiket bilgisi bulunmuyor."},"related_categories":[],"conflicts_with":[],"metadata":{"created_at":"2026-07-18","last_reviewed_at":"2026-09-12","last_reviewed_by":"CEO"}}