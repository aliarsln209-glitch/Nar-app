e bireysel klinik reaksiyonu kesin olarak öngörmez.","clinical_relevance":"moderate","evidence_level":"strong","affects_primary_status":false,"show_to_user":true,"source_refs":["PUBMED-8939159","PUBMED-29858102"]}],"negative_claims":["kabuklu deniz ürünü içermemektedir","kabuklu deniz ürünleri içermemektedir","kabuklu deniz ürünü içermeyen","kabuklu deniz ürünü içermez","kabuklu deniz ürünleri içermez","crustacean-free","crustacean free","free from crustaceans","karides içermez","karidessiz","shrimp-free","shrimp free","free from shrimp","yengeç içermez","crab-free","crab free","ıstakoz içermez","lobster-free","lobster free","kerevit içermez","crayfish-free","crayfish free"],"negation_rules":{"enabled":true,"scope":"same_segment","never_override_contains":true,"never_override_may_contain":true,"detect_conflicts":true,"broad_claims_do_not_suppress":true},"decision_rules":{"status_priority":["contains","may_contain","ambiguous","no_declared_allergen_detected"],"regulatory_exemptions_apply_per_match":true,"negative_claim_does_not_override_contains":true,"conflict_detection":true,"cross_reactivity_affects_primary_status":false,"deduplicate_same_category_matches":true,"prefer_most_specific_match":true,"pal_segment_reclassifies_contains_as_may_contain":true,"product_name_flavor_context_requires_ingredient_confirmation":true,"insufficient_data_enabled":true,"ingredients_required_for_negative_result":true},"warning_texts":{"contains":"Bu ürünün etiketinde {trigger} tespit edildi. Bu ifade Kabuklular (Crustacea) grubundan bir kaynak veya ürünü gösterir ve seçtiğiniz kabuklu alerjisi açısından dikkate alınmalıdır.","may_contain":"Bu ürünün etiketinde Kabuklular (Crustacea) için ihtiyati alerjen veya çapraz bulaşma bildirimi tespit edildi.","ambiguous":"Etiketteki {trigger} ifadesi deniz ürünü veya shellfish kaynağına işaret ediyor ancak bunun Kabuklular (Crustacea) grubuna ait olduğu mevcut bilgilerden kesin olarak belirlenemiyor.","cross_reactivity":"Üründe Yumuşakça grubuna ait bir kaynak tespit edildi. Kabuklular ile bazı yumuşakçalar arasında çapraz reaktivite görülebilir; bu bilgi Kabuklular için doğrudan içerik tespiti anlamına gelmez.","data_conflict":"Ürün bilgilerinde Kabuklular (Crustacea) açısından birbiriyle çelişen beyanlar tespit edildi. Daha ihtiyatlı sonuç gösteriliyor.","no_declared_allergen_detected":"Mevcut ve okunabilir etiket bilgilerinde Kabuklular (Crustacea) grubuna ait açık bir kaynak tespit edilmedi.","insufficient_data":"Bu ürün için Kabuklular (Crustacea) alerjenini güvenilir biçimde değerlendirecek yeterli etiket bilgisi bulunmuyor."},"related_categories":["yumusakca_alerjisi"],"conflicts_with":[],"metadata":{"created_at":"2026-07-18","last_reviewed_at":"2026-09-12","last_reviewed_by":"CEO"}}