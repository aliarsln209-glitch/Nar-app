r_override_contains":true,"never_override_may_contain":true,"detect_conflicts":true,"broad_claims_do_not_suppress":true},"decision_rules":{"status_priority":["contains","may_contain","ambiguous","no_declared_allergen_detected"],"regulatory_exemptions_apply_per_match":true,"negative_claim_does_not_override_contains":true,"conflict_detection":true,"cross_reactivity_affects_primary_status":false,"deduplicate_same_category_matches":true,"prefer_most_specific_match":true,"pal_segment_reclassifies_contains_as_may_contain":true,"product_name_flavor_context_requires_ingredient_confirmation":true,"insufficient_data_enabled":true,"ingredients_required_for_negative_result":true},"warning_texts":{"contains":"Bu ürün {trigger} içeriyor. Seçtiğiniz yumuşakça alerjisi nedeniyle tüketmeniz alerjik reaksiyon riski taşıyabilir.","may_contain":"Bu ürünün etiketinde yumuşakçalar veya yumuşakça ürünleri için ihtiyati alerjen ya da çapraz bulaşma bildirimi bulunuyor.","ambiguous":"Etikette {trigger} ifadesi tespit edildi ancak bunun yumuşakça, kabuklu veya başka bir deniz ürünü kaynağını ifade edip etmediği mevcut ürün bilgilerinden kesin olarak belirlenemiyor.","cross_reactivity":"Bu üründe {trigger} tespit edildi. Kabuklular ile yumuşakçalar arasında bazı bireylerde klinik çapraz reaktivite görülebilir. Bu durum sizde bu ürüne karşı kesin alerji olduğu anlamına gelmez.","data_conflict":"Ürün bilgilerinde birbiriyle çelişen yumuşakça beyanları tespit edildi. Güvenlik açısından daha ihtiyatlı sonuç gösteriliyor.","no_declared_allergen_detected":"Mevcut ürün bilgilerinde yumuşakçalar veya yumuşakça ürünleri ile ilgili bir alerjen beyanı veya eşleşme tespit edilmedi.","insufficient_data":"Bu ürün için yumuşakça alerjenini güvenilir biçimde değerlendirecek yeterli etiket bilgisi bulunmuyor."},"related_categories":["kabuklu_deniz_urunu_alerjisi"],"conflicts_with":[],"metadata":{"created_at":"2026-07-18","last_reviewed_at":"2026-09-12","last_reviewed_by":"CEO"}}