ivity_affects_primary_status":false,"deduplicate_same_category_matches":true,"prefer_most_specific_match":true,"pal_segment_reclassifies_contains_as_may_contain":true,"product_name_flavor_context_requires_ingredient_confirmation":true,"insufficient_data_enabled":true,"ingredients_required_for_negative_result":true},"warning_texts":{"contains":"Bu ürün {trigger} içeriyor. Seçtiğiniz acı bakla alerjisi nedeniyle tüketmeniz alerjik reaksiyon riski taşıyabilir.","may_contain":"Bu ürünün etiketinde acı bakla, lupin veya bunların ürünleri için ihtiyati alerjen ya da çapraz bulaşma bildirimi bulunuyor.","ambiguous":"Bu üründeki {trigger} bilgisinin acı bakla ile ilişkisi mevcut etiket bilgilerinden kesin olarak belirlenemiyor.","cross_reactivity":"Bu üründe {trigger} tespit edildi. Yer fıstığı ile acı bakla arasında bazı bireylerde klinik çapraz reaktivite görülebilir. Bu durum sizde bu ürüne karşı kesin alerji olduğu anlamına gelmez.","data_conflict":"Ürün bilgilerinde birbiriyle çelişen acı bakla beyanları tespit edildi. Güvenlik açısından daha ihtiyatlı sonuç gösteriliyor.","no_declared_allergen_detected":"Mevcut ürün bilgilerinde acı bakla, lupin veya bunların ürünleri ile ilgili bir alerjen beyanı veya eşleşme tespit edilmedi.","insufficient_data":"Bu ürün için acı bakla alerjenini güvenilir biçimde değerlendirecek yeterli etiket bilgisi bulunmuyor."},"related_categories":["yerfistigi_alerjisi"],"conflicts_with":[],"metadata":{"created_at":"2026-07-18","last_reviewed_at":"2026-09-12","last_reviewed_by":"CEO"}}