 içermez","brezilya cevizi içermez","antep fıstığı içermez","macadamia fındığı içermez","queensland fındığı içermez","sert kabuklu meyve içermez","sert kabuklu meyveler içermez","sert kabuklu meyve içermemektedir","sert kabuklu meyveler içermemektedir"],"negation_rules":{"enabled":true,"scope":"same_segment","never_override_contains":true,"never_override_may_contain":true,"detect_conflicts":true,"broad_claims_do_not_suppress":true},"decision_rules":{"status_priority":["contains","may_contain","ambiguous","no_declared_allergen_detected"],"regulatory_exemptions_apply_per_match":true,"negative_claim_does_not_override_contains":true,"conflict_detection":true,"cross_reactivity_affects_primary_status":false,"deduplicate_same_category_matches":true,"prefer_most_specific_match":true,"pal_segment_reclassifies_contains_as_may_contain":true,"product_name_flavor_context_requires_ingredient_confirmation":true,"insufficient_data_enabled":true,"ingredients_required_for_negative_result":true},"warning_texts":{"contains":"Bu ürünün etiketinde {trigger} bulundu. Sert kabuklu meyve alerjiniz varsa tüketmeniz ciddi alerjik reaksiyona yol açabilir.","may_contain":"Bu ürünün etiketinde {trigger} için çapraz bulaşma veya ihtiyati alerjen bildirimi bulunmaktadır. Sert kabuklu meyve alerjiniz varsa dikkatli olunmalıdır.","ambiguous":"Etikette sert kabuklu meyve açısından kesin olarak sınıflandırılamayan bir ifade tespit edildi. İçerik bilgisinin ayrıca kontrol edilmesi önerilir.","no_declared_allergen_detected":"Mevcut etiket bilgilerinde sert kabuklu meyve veya bunlara ilişkin ihtiyati alerjen bildirimi tespit edilmedi. Bu sonuç ürünün kesin olarak alerjensiz olduğunu garanti etmez.","insufficient_data":"Sert kabuklu meyve açısından güvenilir değerlendirme yapmak için etiket bilgisi yetersiz.","data_conflict":"Etiket bilgilerinde sert kabuklu meyve açısından birbiriyle çelişen ifadeler tespit edildi. Ürün güvenilir biçimde sınıflandırılamadı."},"related_categories":["yerfistigi_alerjisi","susam_alerjisi"],"metadata":{"created_at":"2026-07-18","last_reviewed_at":"2026-09-13","last_reviewed_by":"CEO"}}